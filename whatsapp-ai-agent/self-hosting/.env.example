# Copy this file to ".env" and fill in your values.

# The (sub)domain pointing at this server, without https://
DOMAIN=n8n.yourbusiness.com

# Your time zone (list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TIMEZONE=Asia/Karachi

# A long random secret that encrypts your saved credentials.
# Generate one with:  openssl rand -hex 32
# Keep a copy somewhere safe: if you lose it, n8n can't read your saved credentials.
N8N_ENCRYPTION_KEY=replace-with-a-long-random-string
